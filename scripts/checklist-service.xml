<service>
  <id>CheckList</id>
  <name>CheckList</name>
  <description>사내 공용 계층형 체크리스트</description>
  <executable>%BASE%\jre\bin\java.exe</executable>
  <arguments>-jar &quot;%BASE%\checklist.jar&quot; --spring.config.additional-location=file:./config/</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <logpath>%BASE%\logs</logpath>
  <log mode="roll" />
  <onfailure action="restart" delay="10 sec" />
</service>